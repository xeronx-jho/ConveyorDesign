<Window x:Class="ConveyorDesign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ConveyorDesign.ViewModels"
        Title="{Binding Title}" Icon="app.ico" Height="860" Width="1380" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic" FontSize="12">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <CollectionViewSource x:Key="RowsView" Source="{Binding Result.Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Width" Value="190"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
        <Style x:Key="FieldUnit" TargetType="TextBlock" BasedOn="{StaticResource Unit}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4,8,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#FAFBFD"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CalculateCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- 툴바 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding NewCommand}" Content="새로 만들기" Padding="8,2"/>
                <Button Command="{Binding OpenCommand}" Content="열기 (Ctrl+O)" Padding="8,2"/>
                <Button Command="{Binding SaveCommand}" Content="저장 (Ctrl+S)" Padding="8,2"/>
                <Separator/>
                <Button Command="{Binding CalculateCommand}" Content="계산 (F5)" Padding="12,2" FontWeight="Bold"/>
                <CheckBox IsChecked="{Binding AutoCalculate}" Content="입력 변경 시 자동 계산" VerticalAlignment="Center" Margin="8,0"/>
                <Separator/>
                <Button Command="{Binding ExportReportCommand}" Content="보고서 내보내기" Padding="8,2"/>
                <Button Command="{Binding CopyLogCommand}" Content="계산근거 복사" Padding="8,2"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 상태표시줄 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="표준 규격 기반 계산 — 최종 선정은 제조사 카탈로그로 확인" Foreground="#777"/></StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ 왼쪽: 입력 ═══════════ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">

                    <!-- 기본 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="기본"/>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="프로젝트명"/>
                                <TextBox Text="{Binding Input.ProjectName}" HorizontalContentAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="컨베어 종류"/>
                                <ComboBox ItemsSource="{Binding TypeOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Input.Type}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsBelt, Converter={StaticResource BoolToVis}}">
                                <Label Style="{StaticResource FieldLabel}" Content="벨트 종류"/>
                                <ComboBox ItemsSource="{Binding BeltKindOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Input.BeltKind}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 반송 조건 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="반송 조건"/>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="반송 속도  V"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="m/min"/>
                                <TextBox Text="{Binding Input.Speed}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="컨베어 길이 (축간)  L"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="m"/>
                                <TextBox Text="{Binding Input.Length}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="경사각  θ  (+상승 / −하강)"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="°"/>
                                <TextBox Text="{Binding Input.Angle}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="워크 질량  M1"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="kg/개"/>
                                <TextBox Text="{Binding Input.WorkMass}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="워크 개수 (동시 적재)  n1"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="개"/>
                                <TextBox Text="{Binding Input.WorkCount}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="축적(저류) 운전"/>
                                <CheckBox IsChecked="{Binding Input.Accumulation}" Content="워크가 정지한 채 벨트/롤러가 미끄러짐"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}" Visibility="{Binding Input.Accumulation, Converter={StaticResource BoolToVis}}">
                                <Label Style="{StaticResource FieldLabel}" Content="제품–반송면 마찰계수  μST"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="(0.2~0.5)"/>
                                <TextBox Text="{Binding Input.FrictionProduct}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 벨트 컨베어 -->
                    <Border Style="{StaticResource Section}" Visibility="{Binding IsBelt, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="벨트 / 풀리"/>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="벨트 폭  b0"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="mm"/>
                                <TextBox Text="{Binding Input.BeltWidth}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="벨트 단위질량"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="kg/m²"/>
                                <TextBox Text="{Binding Input.BeltMassPerM2}" ToolTip="PVC 2ply ≈ 3~5, 고무 ≈ 8~12, 모듈벨트 ≈ 6~10"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="벨트–지지면 마찰계수  μT"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="(0.03~0.6)"/>
                                <TextBox Text="{Binding Input.FrictionBelt}" ToolTip="슬라이더 베드(강판) 0.3, 롤러 지지 0.03~0.05, 모듈벨트+UHMW 러너 0.13~0.3 (FMS 표 참조)"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="구동 풀리 외경  D1"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="mm"/>
                                <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding PulleyOptions}" Text="{Binding Input.PulleyDiameter}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="구동 풀리 질량  mW"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="kg"/>
                                <TextBox Text="{Binding Input.PulleyMass}"/>
                            </DockPanel>
                            <StackPanel Visibility="{Binding IsRubberBelt, Converter={StaticResource BoolToVis}}">
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="벨트 감김각"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="°"/>
                                    <TextBox Text="{Binding Input.WrapAngle}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="벨트–풀리 마찰계수"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="(0.25~0.4)"/>
                                    <TextBox Text="{Binding Input.FrictionPulley}" ToolTip="맨 강철 풀리 0.25~0.3, 고무 라깅 0.35~0.4"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="벨트 허용 장력 (폭당)"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="N/mm"/>
                                    <TextBox Text="{Binding Input.BeltAllowableTension}" ToolTip="PVC 2ply 6~8, 3ply 10~12, 고무 EP100 ≈ 10/ply"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsModularBelt, Converter={StaticResource BoolToVis}}">
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="운영 팩터  C1 가산"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Input.C1StartStop}" Content="시작-멈춤 (+0.2)"/>
                                        <CheckBox IsChecked="{Binding Input.C1Pushing}" Content="종동 구동 (+0.2)" Margin="10,4,0,4"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Margin="192,0,0,2" Foreground="#777" Text="V &gt; 30 m/min (+0.2), 상승 (+0.4) 은 자동 반영"/>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="온도 팩터  C2"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="(0.45~1.0)"/>
                                    <TextBox Text="{Binding Input.C2Temperature}" ToolTip="20°C 이하 1.0 / PP 60°C 0.85, 80°C 0.65 / POM 60°C 0.96, 80°C 0.75"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="허용 벨트 장력  C3max"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="N/mm"/>
                                    <TextBox Text="{Binding Input.C3Max}" ToolTip="FMS 시리즈별: S1 PE18/PP30/POM40, S5 PE10/PP18/POM25, S8 PE15/PP20/POM40 …"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 롤러 컨베어 -->
                    <Border Style="{StaticResource Section}" Visibility="{Binding IsRoller, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="롤러"/>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="롤러 외경  D1"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="mm"/>
                                <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding RollerOptions}" Text="{Binding Input.RollerDiameter}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="롤러 피치"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="mm"/>
                                <TextBox Text="{Binding Input.RollerPitch}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="롤러 질량 (스프라켓 포함)  M2"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="kg/개"/>
                                <TextBox Text="{Binding Input.RollerMass}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="롤러 축경 (베어링 내경)"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="mm"/>
                                <TextBox Text="{Binding Input.RollerShaftDiameter}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="워크–롤러 굴림마찰  μ1"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="(0.03~0.3)"/>
                                <TextBox Text="{Binding Input.FrictionRolling}" ToolTip="강 롤러·평바닥 0.03~0.05, 고무 라이닝 0.1, 닛세이 참고값 0.2~0.3"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="롤러 베어링 마찰  μ2"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="(0.05~0.1)"/>
                                <TextBox Text="{Binding Input.FrictionBearing}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="롤러 구동 체인 단위질량"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="kg/m"/>
                                <TextBox Text="{Binding Input.RollerChainMassPerM}" ToolTip="RS40 0.64, RS50 1.04, RS60 1.53"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 체인 컨베어 -->
                    <Border Style="{StaticResource Section}" Visibility="{Binding IsChain, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="컨베어 체인 / 스프라켓"/>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="체인 피치  p"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="mm"/>
                                <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding ChainPitchOptions}" Text="{Binding Input.ChainPitch}"
                                          ToolTip="RS40 12.7 / RS50 15.875 / RS60 19.05 / RS80 25.4 / RS100 31.75 / RS120 38.1 / 더블피치 C2050 31.75, C2060 38.1, C2080 50.8"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="체인 열 수"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="열"/>
                                <TextBox Text="{Binding Input.ChainStrands}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="구동 스프라켓 잇수  z"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="T"/>
                                <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding TeethOptions}" Text="{Binding Input.ConveyorSprocketTeeth}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="스프라켓 질량  M2"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="kg/개"/>
                                <TextBox Text="{Binding Input.ConveyorSprocketMass}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="체인 단위질량 (슬랫 등 포함)"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="kg/m·열"/>
                                <TextBox Text="{Binding Input.ChainMassPerM}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="체인–가이드 마찰계수  μ"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="(0.1~0.3)"/>
                                <TextBox Text="{Binding Input.FrictionChain}" ToolTip="롤러체인+강 레일 0.12~0.15, 윤활 0.1, 슬라이딩(강/강) 0.2~0.3, 플라스틱 레일 0.12~0.2"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="체인 최대허용하중 (0=표준표)"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="kN"/>
                                <TextBox Text="{Binding Input.ChainAllowableLoad}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 구동계 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="모터 / 감속기 / 전동"/>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="모터 종류"/>
                                <ComboBox ItemsSource="{Binding MotorKindOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Input.MotorKind}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsInduction, Converter={StaticResource BoolToVis}}">
                                <Label Style="{StaticResource FieldLabel}" Content="모터 극수 / 주파수"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="70" ItemsSource="{Binding PoleOptions}" SelectedItem="{Binding Input.MotorPoles}"/>
                                    <TextBlock Style="{StaticResource Unit}" Text="P"/>
                                    <ComboBox Width="70" Margin="12,2,2,2" ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding Input.Frequency}"/>
                                    <TextBlock Style="{StaticResource Unit}" Text="Hz"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsInduction, Converter={StaticResource BoolToVis}}">
                                <Label Style="{StaticResource FieldLabel}" Content="모터 용량 여유율"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="(1.1~1.5)"/>
                                <TextBox Text="{Binding Input.MotorMargin}"/>
                            </DockPanel>
                            <StackPanel Visibility="{Binding IsServo, Converter={StaticResource BoolToVis}}">
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="서보 정격 회전수"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="rpm"/>
                                    <TextBox Text="{Binding Input.ServoRatedRpm}" ToolTip="저관성 3000, 중관성 2000, 대용량 1500/1000"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="최대토크 배율 (최대/정격)"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="배"/>
                                    <TextBox Text="{Binding Input.ServoMaxTorqueRatio}" ToolTip="일반 3.0, 소용량 3.5 — 카탈로그 확인"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="허용 관성비 (J부하/J모터)"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="배"/>
                                    <TextBox Text="{Binding Input.ServoMaxInertiaRatio}" ToolTip="저관성 모터 10~15, 중관성 5~10 (응답성 중시 시 5 이하)"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="관성비 초과 시"/>
                                    <CheckBox IsChecked="{Binding Input.ServoInertiaAsWarning}" Content="경고만 하고 토크 조건으로 선정 (저속 컨베어)"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="실효토크 사용률 / 회전수 사용률"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="60" Text="{Binding Input.ServoTorqueUtilization}" ToolTip="실효토크 ≤ 정격 × 이 값"/>
                                        <TextBox Width="60" Margin="12,2,2,2" Text="{Binding Input.ServoSpeedUtilization}" ToolTip="최고 회전수 ≤ 정격 × 이 값"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="운전 패턴 (서보)" FontSize="12" Margin="0,6,0,2"/>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="1사이클 이동거리 (0 = 연속)"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="mm"/>
                                    <TextBox Text="{Binding Input.MoveDistance}" ToolTip="인덱싱·정위치 반송 시 1회 이동거리. 0이면 연속 운전"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="감속 시간 / 정지 시간"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="60" Text="{Binding Input.DecelTime}"/>
                                        <TextBlock Style="{StaticResource Unit}" Text="s"/>
                                        <TextBox Width="60" Margin="12,2,2,2" Text="{Binding Input.DwellTime}"/>
                                        <TextBlock Style="{StaticResource Unit}" Text="s"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Margin="192,0,0,2" Foreground="#777" Text="가속 시간은 아래 '운전 조건'의 기동 가속 시간을 사용"/>
                            </StackPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="감속기 효율  η"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="(0.5~0.95)"/>
                                <TextBox Text="{Binding Input.ReducerEfficiency}" ToolTip="헬리컬/평행축 0.9~0.95, 하이포이드 0.85~0.9, 웜 0.5~0.8"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="감속비 (0 = 자동 선정)"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="1/i"/>
                                <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding RatioOptions}" Text="{Binding Input.ManualReducerRatio}"
                                          ToolTip="유도: 속도 오차 최소 / 서보: 관성비·회전수 조건 만족하는 최소 용량 조합 (1 = 직결)"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="전동 방식"/>
                                <ComboBox ItemsSource="{Binding TransmissionOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Input.Transmission}"/>
                            </DockPanel>
                            <StackPanel Visibility="{Binding IsChainDrive, Converter={StaticResource BoolToVis}}">
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="전동 체인 효율"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="(0.93~0.97)"/>
                                    <TextBox Text="{Binding Input.TransmissionEfficiency}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="스프라켓 잇수"/>
                                    <CheckBox IsChecked="{Binding Input.AutoSelectSprockets}" Content="자동 선정 (속도 오차 최소 조합)"/>
                                </DockPanel>
                                <StackPanel Visibility="{Binding IsManualSprocket, Converter={StaticResource BoolToVis}}">
                                    <DockPanel Style="{StaticResource Field}">
                                        <Label Style="{StaticResource FieldLabel}" Content="감속기측 스프라켓  z3"/>
                                        <TextBlock Style="{StaticResource FieldUnit}" Text="T"/>
                                        <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding TeethOptions}" Text="{Binding Input.DriveSprocketTeeth}"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Field}">
                                        <Label Style="{StaticResource FieldLabel}" Content="구동축측 스프라켓  z2"/>
                                        <TextBlock Style="{StaticResource FieldUnit}" Text="T"/>
                                        <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding TeethOptions}" Text="{Binding Input.DrivenSprocketTeeth}"/>
                                    </DockPanel>
                                </StackPanel>
                                <DockPanel Style="{StaticResource Field}">
                                    <Label Style="{StaticResource FieldLabel}" Content="전동 체인 축간거리  C"/>
                                    <TextBlock Style="{StaticResource FieldUnit}" Text="mm"/>
                                    <TextBox Text="{Binding Input.TransmissionCenterDistance}" ToolTip="권장 30~50 피치"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 운전 조건 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="운전 조건 (서비스팩터 · 관성 · OHL)"/>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="하중의 정도"/>
                                <ComboBox ItemsSource="{Binding LoadClassOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Input.LoadClass}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="1일 운전 시간"/>
                                <ComboBox ItemsSource="{Binding DailyHoursOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Input.DailyHours}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="기동 횟수"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="회/일"/>
                                <TextBox Text="{Binding Input.StartsPerDay}" ToolTip="70회/일 초과 시 관성 보정계수 C 증가"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="기동 가속 시간"/>
                                <TextBlock Style="{StaticResource FieldUnit}" Text="s"/>
                                <TextBox Text="{Binding Input.AccelTime}" ToolTip="유도: 직입 ≈ 0.2~0.5 s, 인버터 가속시간 설정값 / 서보: 0.1~0.5 s"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <Label Style="{StaticResource FieldLabel}" Content="OHL 하중 위치"/>
                                <ComboBox ItemsSource="{Binding OhlOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Input.OhlPosition}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- ═══════════ 오른쪽: 결과 ═══════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1F4E79" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="선정 요약" Foreground="#BFD4EA" FontSize="11"/>
                        <TextBlock Text="{Binding Summary}" Foreground="White" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#FFF4E5" BorderBrush="#F0B860" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Warnings}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Warnings}" Foreground="#7A4A00" TextWrapping="Wrap"/>
                </Border>

                <TabControl Grid.Row="2">
                    <TabItem Header="선정 사양">
                        <DataGrid ItemsSource="{Binding Source={StaticResource RowsView}}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E8EE"
                                  CanUserAddRows="False" CanUserResizeRows="False" RowHeight="24" AlternatingRowBackground="#F7F9FC"
                                  SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1F4E79" Background="#E8EEF6" Padding="6,3"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="항목" Binding="{Binding Item}" Width="230"/>
                                <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="70"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="계산 근거">
                        <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas, Malgun Gothic" FontSize="12"
                                 TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Left" Padding="8" Background="#FCFCFC"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
